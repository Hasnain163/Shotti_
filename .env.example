# Shotti? AI — backend environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- AI (required for the verify pipeline, phase 2) ---
GEMINI_API_KEY=
# gemini-2.5-* models are no longer available to new API keys.
GEMINI_MODEL=gemini-3.7-flash
# Request timeout in milliseconds.
GEMINI_TIMEOUT_MS=30000

# --- Web research (required for the verify pipeline, phase 2) ---
FIRECRAWL_API_KEY=
# Research tuning. Lower the source count to cut latency and credit use.
FIRECRAWL_SEARCH_LIMIT=5
FIRECRAWL_MAX_SOURCES=6
FIRECRAWL_MAX_PER_DOMAIN=2
FIRECRAWL_MAX_CHARS_PER_SOURCE=3000
FIRECRAWL_MAX_TOTAL_CHARS=15000

# --- Voice (optional, phase 3) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- App config (optional, sensible defaults in app/config.py) ---
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
